{
  "version": 1,
  "enabled": true,
  "auto_apply_low_risk": true,
  "allow_high_risk": false,
  "model": "openai/gpt-oss-120b",
  "temperature": 0.4,
  "max_actions": 6,
  "max_files_per_run": 8,
  "max_changed_lines_per_run": 120,
  "max_new_text_bytes": 20000,
  "require_tests_pass": true,
  "editable_roots": ["."],
  "allowed_extensions": [".html", ".htm", ".js", ".css", ".json", ".md", ".txt", ".svg", ".xml"],
  "blocked_patterns": [
    "**/.git/**",
    "**/*.db",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.db-journal",
    "**/db_backup.json",
    "**/test_backup.json",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/k8s-manifests/**",
    "**/terraform/**",
    "**/*.tf",
    "**/*.tfvars",
    "**/k3s-platform/**",
    "**/.github/**",
    "**/omnitest/**",
    "**/work/**",
    "**/marketing_system/data/**",
    "**/marketing_system/tests/**",
    "**/ai-tuner/**",
    "**/scripts/ai_tuner.py",
    "**/scripts/inject_beacon.py",
    "**/secrets/**",
    "**/*secret*",
    "**/*credential*",
    "**/*token*"
  ],
  "sync_pairs": [
    { "from": "docs", "to": "xiangchuan/docs" }
  ],
  "state_dir": "xiangchuan/ai-tuner",
  "dedupe_days": 21,
  "api_base": "https://lewislunora.onrender.com",
  "sites": [
    "https://lewislunora.onrender.com/",
    "https://lewislunora.github.io/lewislunora/"
  ]
}
